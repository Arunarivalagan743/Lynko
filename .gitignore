*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
dist/
build/
frontend/dist/

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/

# Temporary wrapper scripts
powershell.bat
frontend/powershell.bat