# Dependencies - never commit these
node_modules/
**/node_modules/
backend/node_modules/
frontend/node_modules/

# Environment Variables - never commit secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env.*
!.env.example
!**/.env.example

